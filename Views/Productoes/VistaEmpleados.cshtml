@model IEnumerable<webBotica2.Models.Producto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-center mb-4">Lista de Productos</h2>

<form asp-action="VistaEmpleados" method="get" class="mb-3 d-flex">
    <input type="text" name="searchString" class="form-control me-2"
           placeholder="Buscar por código o nombre..."
           value="@Context.Request.Query["searchString"]" />
    <button type="submit" class="btn btn-primary">Buscar</button>

    <a asp-action="VistaEmpleados" class="btn btn-secondary">Limpiar</a>
</form>




<table class="table table-bordered table-hover table-striped align-middle text-center shadow-sm" style="font-size: 13px;">
    <thead class="table-success">
        <tr>
            <th>SKU</th>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Precio Compra</th>
            <th>Precio Venta</th>
            <th>F. Vencimiento</th>
            <th>Stock</th>
            <th>Stock Min.</th>
            <th>Categoría</th>
            <th>Marca</th>
            <th>Proveedor</th>
            <th>Laboratorio</th>
            <th>Estado</th>
            
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Sku</td>
                <td>@item.Nombre</td>
                <td>@item.Presentacion</td>
                <td>@item.PrecioCompra.ToString("C")</td>
                <td>@item.PrecioVenta.ToString("C")</td>
                <td>@item.FechaVen.ToString("dd/MM/yyyy")</td>
                <td>@item.Stock</td>-
                <td>@item.StockMinimo</td>
                <td>@item.IdCategoriaNavigation.Nombre</td>
                <td>@item.IdMarcaNavigation.Nombre</td>
                <td>@item.IdProveedorNavigation.RazonSocial</td>
                <td>@item.IdLaboratorioNavigation.Nombre</td>
                <td>
                    @(item.Estado ? "✅" : "❌")
                </td>
            </tr>
        }
    </tbody>
</table>
